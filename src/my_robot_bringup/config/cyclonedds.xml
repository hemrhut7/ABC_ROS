<?xml version="1.0" encoding="UTF-8"?>
<!--
  CycloneDDS cross-network configuration for remote RVIZ2 access.
  
  Usage (both Jetson and remote PC):
    export RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
    export CYCLONEDDS_URI=file://$(pwd)/src/my_robot_bringup/config/cyclonedds.xml
  
  NOTE: Replace <REMOTE_PC_IP> and <JETSON_IP> with actual IP addresses.
        Both sides must use the same ROS_DOMAIN_ID (default: 0).
-->
<CycloneDDS>
  <Domain>
    <General>
      <Interfaces>
        <!-- Use the correct network interface (eth0, wlan0, etc.) -->
        <NetworkInterface autodetermine="true" />
      </Interfaces>
      <!-- Allow multicast for local discovery -->
      <AllowMulticast>default</AllowMulticast>
    </General>
    <Discovery>
      <Peers>
        <!-- ============================================ -->
        <!-- Replace with actual IP addresses             -->
        <!-- On Jetson:  set remote PC's IP               -->
        <!-- On remote PC: set Jetson's IP                -->
        <!-- ============================================ -->
        <Peer address="192.168.1.154"/>
      </Peers>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
  </Domain>
</CycloneDDS>
